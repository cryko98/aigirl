# ---- Server ----
PORT=3000

# ---- AI (Anthropic Claude) ----
# Ha üres, a szerver "mock" módban fut: beépített, kőkemény őrszem-logikával válaszol.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Hang (ElevenLabs) ----
# Ha üres, a böngésző beépített Web Speech API-ját használja a kliens.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Solana ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# A reward pot publikus címe (ez jelenik meg az oldalon és ebből megy a kifizetés)
TREASURY_PUBLIC_KEY=
# A pot privát kulcsa base58 formában (Phantom export) VAGY JSON tömb (solana-keygen). SOHA ne kerüljön a frontendre.
TREASURY_SECRET_KEY=
# Ha üres a secret, a kifizetés "szimulált" (naplózza, de nem küld tranzakciót).
# Demo pot érték megjelenítéshez, ha nincs treasury beállítva
DEMO_POT_SOL=0

# ---- Kifizetési szabályok (kemény korlátok, az AI nem írhatja felül) ----
MAX_PAYOUT_SOL=0.5            # egy kifizetés abszolút maximuma
MAX_POT_SHARE=0.05            # egy kifizetés max a pot ekkora hányada (5%)
MAX_PER_WALLET_SOL=0.75       # egy wallet összesen ennyit kaphat
MAX_WINS_PER_WALLET=2         # egy wallet max ennyi alkalommal nyerhet
MIN_TURNS_BEFORE_PAYOUT=6     # legalább ennyi üzenetváltás kell a kifizetés előtt
PAYOUT_COOLDOWN_MIN=20        # két globális kifizetés között min. ennyi perc
DAILY_PAYOUT_CAP_SOL=3        # napi összes kifizetés plafonja
GLOBAL_WIN_CHANCE_SCALER=1    # 1 = normál, <1 szigorúbb
MESSAGE_RATE_LIMIT=8          # üzenet / perc / wallet
